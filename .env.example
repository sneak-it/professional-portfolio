# Runtime configuration. Copy to .env and edit; every variable is optional and
# falls back to the generic placeholder shown. Read when the process starts, so
# the same prebuilt image serves any identity under any domain, no rebuild.
#
# docker-compose.yml loads this via `env_file`. From source, Next reads .env
# from the project root automatically in `next dev`, `next build`, and
# `next start`. Real environment variables always win over the file.
#
# The published image does not contain a .env (.dockerignore excludes it), so
# configure containers with real environment variables, which is what the
# compose `env_file` entry does.

# Canonical origin for Open Graph cards, sitemap, robots.txt, and JSON-LD.
# No trailing slash.
SITE_URL=http://localhost:3000

# Identity.
SITE_NAME=Your Name
# Browser/OG title. Defaults to SITE_NAME.
SITE_TITLE=
SITE_DESCRIPTION=Personal portfolio and blog: projects, writing, and photography.
# Byline and JSON-LD author. Defaults to SITE_NAME.
SITE_AUTHOR=
SITE_LOCATION=Your City, ST
# Wordmark in the navbar and footer.
SITE_MONOGRAM=YN

# Portrait on the about page and the blog byline. Must stay on a host allowed
# by images.remotePatterns and the CSP in next.config.ts, which are baked at
# build time; a URL on any other host renders broken.
SITE_AVATAR_URL=https://picsum.photos/seed/portrait/800/800

# Social profiles. Set to empty to hide a link entirely.
SITE_GITHUB_URL=https://github.com/your-username
SITE_LINKEDIN_URL=https://linkedin.com/in/your-profile
