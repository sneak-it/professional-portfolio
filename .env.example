# Runtime configuration. Copy to .env and edit; every variable is optional and
# falls back to the placeholder shown. Read at process start, so one prebuilt
# image serves any identity under any domain.
#
# Loaded by docker-compose via `env_file`, and by Next from the project root
# when running from source. Real environment variables win over the file, and
# the published image ships no .env (.dockerignore excludes it, and the
# Dockerfile deletes the copy `next build` writes into .next/standalone).
#
# `env_file` is optional, so a file that never loaded looks like a working
# deploy. The container logs `[site] SITE_NAME unset` at start when it did not.

# Canonical origin for Open Graph cards, sitemap, robots.txt, and JSON-LD.
# Absolute http(s) URL, scheme included; no trailing slash. Anything else warns
# and falls back rather than failing the request.
SITE_URL=http://localhost:3000

# Identity.
SITE_NAME=Your Name
# Browser/OG title. Defaults to SITE_NAME.
SITE_TITLE=
SITE_DESCRIPTION=Personal portfolio and blog: projects, writing, and photography.
# Byline and JSON-LD author. Defaults to SITE_NAME.
SITE_AUTHOR=
SITE_LOCATION=Your City, ST
# Wordmark in the navbar and footer, and on the generated icons and OG card.
# First 3 characters are used.
SITE_MONOGRAM=YN
# BCP 47 language tag for <html lang> and the Open Graph locale.
SITE_LOCALE=en-US

# Portrait on the about page and the blog byline. Site-relative only, and under
# a directory in images.localPatterns (next.config.ts, baked at build time):
# drop your file into public/images/ and point this at it.
SITE_AVATAR_URL=/images/avatar-placeholder.png

# Social profiles. Set to empty to hide a link entirely.
SITE_GITHUB_URL=https://github.com/your-username
SITE_LINKEDIN_URL=https://linkedin.com/in/your-profile
# Contact email. Unset by default; the contact page omits the card.
SITE_EMAIL=

# Operational tuning. All optional; a non-integer or non-positive value falls
# back to the default shown.

# Posts per page on /blog.
BLOG_POSTS_PER_PAGE=3

# How long sitemap.xml and feed.xml reuse a scanned content list. Bounds scan
# cost and how long a new file takes to appear. Pages render per request and are
# unaffected.
SITEMAP_CACHE_TTL_MS=300000

# Entries in the image dimension cache, one per distinct image path rendered.
IMAGE_DIMENSION_CACHE_MAX=2000
